    gml:id="ID_01">

  <message:hasMember>
    <aixm:AirportHeliport gml:id="id.cccc0001-0000-0000-0000-000000000001">
      <gml:identifier codeSpace="urn:uuid:">cccc0001-0000-0000-0000-000000000001</gml:identifier>
      <aixm:timeSlice>
        <aixm:AirportHeliportTimeSlice gml:id="id.ts.cccc0001">
          <gml:validTime>
            <gml:TimePeriod gml:id="id.ts.vt.cccc0001">
              <gml:beginPosition>2026-08-06T00:00:00</gml:beginPosition>
