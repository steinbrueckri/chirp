          <aixm:fieldElevation uom="FT">1000</aixm:fieldElevation>
          <aixm:ARP>
            <aixm:ElevatedPoint gml:id="id.ts.arp.cccc0001" srsName="urn:ogc:def:crs:EPSG::4326">
              <gml:pos>51.050000 11.000000</gml:pos>
              <aixm:elevation uom="FT">1000</aixm:elevation>
